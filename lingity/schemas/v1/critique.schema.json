{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingity.dev/schemas/v1/critique.schema.json",
  "$comment": "A deterministic improvement brief. It states what is wrong and what must not change; it never states a verdict.",
  "title": "Lingity critique brief v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "analyzer_version",
    "linguistic_model",
    "profile",
    "source",
    "current_score",
    "defects",
    "must_preserve",
    "protected_sha256",
    "acceptance",
    "rewrite_constraints",
    "prior_attempts",
    "critique_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "kind": {"const": "lingity.critique.v1"},
    "analyzer_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "linguistic_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "runtime", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "runtime": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sha256"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "current_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "band"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 100},
        "band": {"enum": ["revision_required", "usable_but_improvable", "clear"]}
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "dimension",
          "severity",
          "location",
          "observed_value",
          "threshold",
          "remediation",
          "excerpt"
        ],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^LING-[A-Z-]+-[0-9]{3}$"},
          "dimension": {"type": "string", "minLength": 1},
          "severity": {"enum": ["low", "medium", "high"]},
          "location": {
            "type": "object",
            "required": ["start", "end", "line", "column"],
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 0},
              "line": {"type": "integer", "minimum": 1},
              "column": {"type": "integer", "minimum": 1},
              "sentence_index": {"type": "integer", "minimum": 0}
            }
          },
          "observed_value": {},
          "threshold": {},
          "remediation": {"type": "string", "minLength": 1},
          "excerpt": {"type": "string", "minLength": 1}
        }
      }
    },
    "must_preserve": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "kind", "text", "normalized"],
        "properties": {
          "category": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "normalized": {"type": "string"}
        }
      }
    },
    "protected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_higher_score",
        "requires_protected_equivalence",
        "forbids_new_high_severity_findings",
        "requires_economy_budget"
      ],
      "properties": {
        "requires_higher_score": {"const": true},
        "requires_protected_equivalence": {"const": true},
        "forbids_new_high_severity_findings": {"const": true},
        "requires_economy_budget": {"const": true}
      }
    },
    "rewrite_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editing_mode",
        "source_readable_words",
        "max_readable_word_growth_percent",
        "max_readable_word_growth_absolute",
        "maximum_candidate_readable_words",
        "prefer_shorter_candidate"
      ],
      "properties": {
        "editing_mode": {"const": "minimum_necessary_change"},
        "source_readable_words": {"type": "integer", "minimum": 0},
        "max_readable_word_growth_percent": {"type": "number", "minimum": 0},
        "max_readable_word_growth_absolute": {"type": "integer", "minimum": 0},
        "maximum_candidate_readable_words": {"type": "integer", "minimum": 0},
        "prefer_shorter_candidate": {"type": "boolean"}
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "contract", "instructions"],
      "properties": {
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "digest"],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "version": {
              "type": "string",
              "pattern": "^1\\.[0-9]+\\.[0-9]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "contract": {
          "$ref": "#/$defs/styleContract"
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prior_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "rejection_reasons"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rejection_reasons": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "score_after": {"type": "number"},
          "protected_disposition": {
            "enum": ["equivalent", "changed", "unresolved"]
          }
        }
      }
    },
    "critique_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "styleExamples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "reason"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "styleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "name",
        "version",
        "language",
        "title",
        "reader_outcome",
        "content_policy",
        "rhetorical_shape",
        "editing_posture",
        "observable_tendencies",
        "positive_guidance",
        "negative_guidance",
        "positive_examples",
        "negative_examples"
      ],
      "properties": {
        "$schema": {
          "const": "https://lingity.dev/schemas/v1/style-contract.schema.json"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "language": {"const": "en"},
        "title": {"type": "string", "minLength": 1},
        "reader_outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audience", "outcome", "scan_priority"],
          "properties": {
            "audience": {"type": "string", "minLength": 1},
            "outcome": {"type": "string", "minLength": 1},
            "scan_priority": {"$ref": "#/$defs/nonEmptyStringArray"}
          }
        },
        "content_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preserve", "do_not_add"],
          "properties": {
            "preserve": {"$ref": "#/$defs/nonEmptyStringArray"},
            "do_not_add": {"$ref": "#/$defs/nonEmptyStringArray"}
          }
        },
        "rhetorical_shape": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lead", "sequence", "ending"],
          "properties": {
            "lead": {"type": "string", "minLength": 1},
            "sequence": {"$ref": "#/$defs/nonEmptyStringArray"},
            "ending": {"type": "string", "minLength": 1}
          }
        },
        "editing_posture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "change_scope",
            "allowed_moves",
            "prohibited_moves"
          ],
          "properties": {
            "role": {"type": "string", "minLength": 1},
            "change_scope": {"type": "string", "minLength": 1},
            "allowed_moves": {"$ref": "#/$defs/nonEmptyStringArray"},
            "prohibited_moves": {"$ref": "#/$defs/nonEmptyStringArray"}
          }
        },
        "observable_tendencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tendency", "reason"],
            "properties": {
              "tendency": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "positive_guidance": {"$ref": "#/$defs/nonEmptyStringArray"},
        "negative_guidance": {"$ref": "#/$defs/nonEmptyStringArray"},
        "positive_examples": {"$ref": "#/$defs/styleExamples"},
        "negative_examples": {"$ref": "#/$defs/styleExamples"}
      }
    }
  }
}
