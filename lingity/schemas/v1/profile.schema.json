{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingity.dev/schemas/v1/profile.schema.json",
  "$comment": "Packaged with Lingity so installed analysis remains reproducible.",
  "title": "Lingity profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "version", "language", "weights", "bands", "thresholds", "rules"],
  "properties": {
    "$schema": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "language": {"const": "en"},
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentence_load", "morphology", "agency", "lexical_clarity", "structure", "redundancy"],
      "properties": {
        "sentence_load": {"type": "integer", "minimum": 0, "maximum": 100},
        "morphology": {"type": "integer", "minimum": 0, "maximum": 100},
        "agency": {"type": "integer", "minimum": 0, "maximum": 100},
        "lexical_clarity": {"type": "integer", "minimum": 0, "maximum": 100},
        "structure": {"type": "integer", "minimum": 0, "maximum": 100},
        "redundancy": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "minimum", "maximum"],
        "properties": {
          "name": {"type": "string"},
          "minimum": {"type": "number", "minimum": 0, "maximum": 100},
          "maximum": {"type": "number", "minimum": 0, "maximum": 100}
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0},
      "required": [
        "max_sentence_words", "max_actions_per_sentence", "max_clauses_per_sentence",
        "max_nominalizations_per_sentence", "noun_stack_words", "max_paragraph_words",
        "max_repeated_content_word"
      ]
    },
    "rules": {
      "type": "object",
      "required": [
        "nominalization_suffixes", "nominalization_exclusions", "nominalizations",
        "hidden_agency", "weak_verbs", "jargon", "bureaucratic_phrases", "protected_concepts"
      ]
    }
  }
}
