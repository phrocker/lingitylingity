{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingity.dev/schemas/v1/verdict.schema.json",
  "$comment": "The deterministic decision on a single candidate rewrite. A rejected candidate must always carry at least one reason.",
  "title": "Lingity candidate verdict v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "accepted",
    "rejection_reasons",
    "source_score",
    "candidate_score",
    "protected_disposition",
    "protected_delta",
    "economy",
    "challenge",
    "profile",
    "linguistic_model"
  ],
  "properties": {
    "schema_version": {"const": "1.3.0"},
    "accepted": {"type": "boolean"},
    "rejection_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "source_score": {"type": "number", "minimum": 0, "maximum": 100},
    "candidate_score": {"type": "number", "minimum": 0, "maximum": 100},
    "protected_disposition": {"enum": ["equivalent", "changed", "unresolved"]},
    "protected_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing", "added", "unresolved", "specified"],
      "description": "Exactly which protected elements moved, so a rejected candidate can be repaired by name rather than guessed at.",
      "properties": {
        "missing": {"type": "array", "items": {"type": "string"}},
        "added": {"type": "array", "items": {"type": "string"}},
        "unresolved": {"type": "array", "items": {"type": "string"}},
        "specified": {"type": "array", "items": {"type": "string"}}
      }
    },
    "economy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_readable_words",
        "candidate_readable_words",
        "growth",
        "allowed_growth",
        "maximum_candidate_readable_words",
        "prefer_shorter_candidate",
        "passed"
      ],
      "properties": {
        "source_readable_words": {"type": "integer", "minimum": 0},
        "candidate_readable_words": {"type": "integer", "minimum": 0},
        "growth": {"type": "integer"},
        "allowed_growth": {"type": "integer", "minimum": 0},
        "maximum_candidate_readable_words": {"type": "integer", "minimum": 0},
        "prefer_shorter_candidate": {"type": "boolean"},
        "passed": {"type": "boolean"}
      }
    },
    "challenge": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition", "claims", "provider", "model"],
          "properties": {
            "disposition": {
              "enum": ["no_material_change", "material_change", "needs_human"]
            },
            "claims": {"type": "array", "items": {"type": "string"}},
            "provider": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "grade_goal": {
      "type": "object",
      "required": ["formula", "source_grade", "candidate_grade", "target_grade", "passed"],
      "properties": {
        "formula": {"const": "flesch_kincaid_grade"},
        "source_grade": {"type": ["number", "null"]},
        "candidate_grade": {"type": ["number", "null"]},
        "target_grade": {"type": "number", "minimum": 0},
        "passed": {"type": "boolean"}
      }
    },
    "fact_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_sha256", "sources", "source", "candidate", "passed"],
      "properties": {
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "url", "retrieved_at", "sha256"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "url": {"type": "string", "minLength": 1},
              "retrieved_at": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "source": {"$ref": "#/$defs/factReview"},
        "candidate": {"$ref": "#/$defs/factReview"},
        "passed": {"type": "boolean"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "linguistic_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "runtime", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "runtime": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "factReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_sha256", "evidence_sha256", "provider", "model", "passed", "sentences"],
      "properties": {
        "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "sentences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "text", "status", "claims", "reason"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "text": {"type": "string", "minLength": 1},
              "status": {"enum": ["supported", "contradicted", "unresolved", "not_factual"]},
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["text", "status", "citations", "reason"],
                  "properties": {
                    "text": {"type": "string", "minLength": 1},
                    "status": {"enum": ["supported", "contradicted", "unresolved"]},
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["source_id", "quote"],
                        "properties": {
                          "source_id": {"type": "string", "minLength": 1},
                          "quote": {"type": "string", "minLength": 1}
                        }
                      }
                    },
                    "reason": {"type": "string", "minLength": 1}
                  }
                }
              },
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "A rejection without a reason would be an unattributed verdict.",
      "if": {"properties": {"accepted": {"const": false}}},
      "then": {"properties": {"rejection_reasons": {"minItems": 1}}}
    },
    {
      "$comment": "An accepted candidate must carry no outstanding reason.",
      "if": {"properties": {"accepted": {"const": true}}},
      "then": {"properties": {"rejection_reasons": {"maxItems": 0}}}
    }
  ]
}
