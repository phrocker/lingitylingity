{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingity.dev/schemas/v1/analysis.schema.json",
  "$comment": "Canonical deterministic analysis contract.",
  "title": "Lingity deterministic analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analyzer_version",
    "linguistic_model",
    "profile",
    "rewrite_policy",
    "source",
    "sentences",
    "protected",
    "findings",
    "score",
    "readability_estimates",
    "analysis_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3.0"
    },
    "analyzer_version": {
      "type": "string"
    },
    "analysis_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "linguistic_model": {
      "type": "object",
      "description": "Pinned parsing pipeline this analysis is reproducible against.",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "runtime",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "profile": {
      "$ref": "#/$defs/profileRef"
    },
    "rewrite_policy": {
      "$ref": "#/$defs/rewritePolicy"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "sha256",
        "length"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "length": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sentences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "start",
          "end",
          "text",
          "word_count",
          "clause_count",
          "action_count"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          },
          "word_count": {
            "type": "integer",
            "minimum": 0
          },
          "clause_count": {
            "type": "integer",
            "minimum": 1
          },
          "action_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "protected": {
      "$ref": "#/$defs/protectedManifest"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "band",
        "formula",
        "components"
      ],
      "properties": {
        "name": {
          "const": "Human Readability Index"
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "band": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "weight",
              "raw_score",
              "deducted_points",
              "weighted_contribution",
              "deductions"
            ],
            "properties": {
              "dimension": {
                "type": "string"
              },
              "weight": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "raw_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "deducted_points": {
                "type": "number",
                "minimum": 0
              },
              "weighted_contribution": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "deductions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rule_id",
                    "points"
                  ],
                  "properties": {
                    "rule_id": {
                      "type": "string"
                    },
                    "points": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "readability_estimates": {
      "type": "object",
      "description": "Grade-level estimates from several standard formulas, for the whole document and for each sentence, with the exact formula and counts behind every value. Surface-feature estimates, not a measure of comprehension.",
      "additionalProperties": false,
      "required": ["version", "method", "document", "sentences"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": ["word", "sentence", "character", "polysyllable", "rounding", "formulas", "syllables", "normalization", "grade_threshold"],
          "properties": {
            "word": {"type": "string", "minLength": 1},
            "sentence": {"type": "string", "minLength": 1},
            "character": {"type": "string", "minLength": 1},
            "polysyllable": {"type": "string", "minLength": 1},
            "rounding": {"type": "string", "minLength": 1},
            "formulas": {"$ref": "#/$defs/readabilityFormulaStrings"},
            "syllables": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "pronunciation", "fallback"],
              "properties": {
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "repository", "commit", "source_file", "source_sha256", "license", "table", "table_sha256", "entries", "derivation"],
                  "properties": {
                    "name": {"type": "string"},
                    "repository": {"type": "string"},
                    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
                    "source_file": {"type": "string"},
                    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                    "license": {"type": "string"},
                    "table": {"type": "string"},
                    "table_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                    "entries": {"type": "integer", "minimum": 1},
                    "derivation": {"type": "string"}
                  }
                },
                "pronunciation": {"type": "string"},
                "fallback": {"type": "string", "minLength": 1}
              }
            },
            "normalization": {
              "type": "object",
              "additionalProperties": false,
              "required": ["applied", "rule", "figure_syllables", "figure_characters"],
              "properties": {
                "applied": {"type": "boolean"},
                "rule": {"type": "string", "minLength": 1},
                "figure_syllables": {"type": "integer", "minimum": 0},
                "figure_characters": {"type": "integer", "minimum": 0}
              }
            },
            "grade_threshold": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["rule_id", "formula", "max_grade", "min_words"],
                  "properties": {
                    "rule_id": {"type": "string", "pattern": "^LING-[A-Z-]+-[0-9]{3}$"},
                    "formula": {"$ref": "#/$defs/readabilityFormulaName"},
                    "max_grade": {"type": "number", "minimum": 0},
                    "min_words": {"type": "integer", "minimum": 0}
                  }
                }
              ]
            }
          }
        },
        "document": {
          "type": "object",
          "additionalProperties": false,
          "required": ["counts", "estimates", "without_normalization"],
          "properties": {
            "counts": {"$ref": "#/$defs/readabilityCounts"},
            "estimates": {
              "type": "object",
              "additionalProperties": false,
              "required": ["flesch_kincaid_grade", "flesch_reading_ease", "coleman_liau_index", "smog_grade", "gunning_fog", "automated_readability_index"],
              "properties": {
                "flesch_kincaid_grade": {"$ref": "#/$defs/readabilityEstimate"},
                "flesch_reading_ease": {"$ref": "#/$defs/readabilityEstimate"},
                "coleman_liau_index": {"$ref": "#/$defs/readabilityEstimate"},
                "smog_grade": {"$ref": "#/$defs/readabilityEstimate"},
                "gunning_fog": {"$ref": "#/$defs/readabilityEstimate"},
                "automated_readability_index": {"$ref": "#/$defs/readabilityEstimate"}
              }
            },
            "without_normalization": {
              "type": "object",
              "additionalProperties": false,
              "required": ["counts", "values"],
              "properties": {
                "counts": {"$ref": "#/$defs/readabilityCounts"},
                "values": {"$ref": "#/$defs/readabilityValues"}
              }
            }
          }
        },
        "sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sentence_index", "start", "end", "counts", "values"],
            "properties": {
              "sentence_index": {"type": "integer", "minimum": 0},
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 1},
              "counts": {"$ref": "#/$defs/readabilityCounts"},
              "values": {"$ref": "#/$defs/readabilityValues"}
            }
          }
        }
      }
    },
    "ingest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "parser",
        "blocks",
        "analyzed_characters",
        "unresolved_lines",
        "uncovered_lines"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "markdown"
          ]
        },
        "blocks": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "analyzed_characters": {
          "type": "integer",
          "minimum": 0
        },
        "parser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "unresolved_lines": {
          "type": "integer",
          "minimum": 0
        },
        "uncovered_lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "readabilityFormulaName": {
      "enum": ["flesch_kincaid_grade", "flesch_reading_ease", "coleman_liau_index", "smog_grade", "gunning_fog", "automated_readability_index"]
    },
    "readabilityFormulaStrings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flesch_kincaid_grade", "flesch_reading_ease", "coleman_liau_index", "smog_grade", "gunning_fog", "automated_readability_index"],
      "properties": {
        "flesch_kincaid_grade": {"type": "string"},
        "flesch_reading_ease": {"type": "string"},
        "coleman_liau_index": {"type": "string"},
        "smog_grade": {"type": "string"},
        "gunning_fog": {"type": "string"},
        "automated_readability_index": {"type": "string"}
      }
    },
    "readabilityValue": {"type": ["number", "null"]},
    "readabilityValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flesch_kincaid_grade", "flesch_reading_ease", "coleman_liau_index", "smog_grade", "gunning_fog", "automated_readability_index"],
      "properties": {
        "flesch_kincaid_grade": {"$ref": "#/$defs/readabilityValue"},
        "flesch_reading_ease": {"$ref": "#/$defs/readabilityValue"},
        "coleman_liau_index": {"$ref": "#/$defs/readabilityValue"},
        "smog_grade": {"$ref": "#/$defs/readabilityValue"},
        "gunning_fog": {"$ref": "#/$defs/readabilityValue"},
        "automated_readability_index": {"$ref": "#/$defs/readabilityValue"}
      }
    },
    "readabilityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["words", "sentences", "syllables", "characters", "polysyllables", "figures", "excluded_words", "dictionary_words", "fallback_words"],
      "properties": {
        "words": {"type": "integer", "minimum": 0},
        "sentences": {"type": "integer", "minimum": 0},
        "syllables": {"type": "integer", "minimum": 0},
        "characters": {"type": "integer", "minimum": 0},
        "polysyllables": {"type": "integer", "minimum": 0},
        "figures": {"type": "integer", "minimum": 0},
        "excluded_words": {"type": "integer", "minimum": 0},
        "dictionary_words": {"type": "integer", "minimum": 0},
        "fallback_words": {"type": "integer", "minimum": 0}
      }
    },
    "readabilityEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "formula", "counts"],
      "properties": {
        "value": {"$ref": "#/$defs/readabilityValue"},
        "formula": {"type": "string", "minLength": 1},
        "counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "rewritePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_readable_word_growth_percent",
        "max_readable_word_growth_absolute",
        "prefer_shorter_candidate"
      ],
      "properties": {
        "max_readable_word_growth_percent": {"type": "number", "minimum": 0},
        "max_readable_word_growth_absolute": {"type": "integer", "minimum": 0},
        "prefer_shorter_candidate": {"type": "boolean"}
      }
    },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "line",
        "column"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "sentence_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "dimension",
        "severity",
        "location",
        "observed_value",
        "threshold",
        "remediation",
        "penalty"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^LING-[A-Z-]+-[0-9]{3}$"
        },
        "dimension": {
          "enum": [
            "sentence_load",
            "morphology",
            "agency",
            "lexical_clarity",
            "structure",
            "redundancy"
          ]
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "observed_value": {
          "$ref": "#/$defs/findingValue"
        },
        "threshold": {
          "$ref": "#/$defs/findingValue"
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        },
        "penalty": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "findingValue": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/findingValue"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/findingValue"
          }
        }
      ]
    },
    "protectedManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "semantic_signature",
        "sha256",
        "coverage",
        "source_sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "semantic_signature": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "kind",
              "text",
              "normalized",
              "location"
            ],
            "properties": {
              "category": {
                "enum": [
                  "identifier",
                  "quantity",
                  "modal",
                  "negation",
                  "citation",
                  "governance",
                  "order"
                ]
              },
              "kind": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "normalized": {
                "type": "string"
              },
              "location": {
                "$ref": "#/$defs/location"
              }
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sentences",
            "uncovered"
          ],
          "properties": {
            "sentences": {
              "type": "integer",
              "minimum": 0
            },
            "uncovered": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sentence_index",
                  "text",
                  "content"
                ],
                "properties": {
                  "sentence_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "text": {
                    "type": "string"
                  },
                  "content": {
                    "description": "Dependency fingerprint of the sentence's content words, as sorted 'lemma|role|head-lemma' triples. Lets a comparison reconcile the same uncovered proposition across a sentence split without re-parsing the text.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
