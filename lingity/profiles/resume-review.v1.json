        "evaluate",
        "investigate",
        "research"
      ],
      "improvement": [
        "automate",
        "cut",
        "improve",
        "optimize",
        "reduce",
        "streamline"
      ],
      "communication": [
        "document",
        "present",
        "publish",
        "report",
        "write"
      ]
    },
    "recommendation_action_groups": {
      "build": [
        "build",
        "create",
        "develop",
        "implement",
        "launch",
        "ship"
      ],
      "lead": [
        "direct",
