      "SQL",
      "SRE",
      "TCP",
      "TLS",
      "UI",
      "URL",
      "UX",
      "VM",
      "XML",
      "YAML"
    ],
    "purpose_markers": {
      "delivery": [
        "build",
        "create",
        "deliver",
        "deploy",
        "develop",
        "launch",
        "ship"
      ],
      "leadership": [
        "coach",
        "coordinate",
        "direct",
        "lead",
        "manage",
        "mentor",
        "supervise"
      ],
      "analysis": [
        "analyze",
