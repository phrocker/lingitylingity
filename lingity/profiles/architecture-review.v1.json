{
  "$schema": "https://lingity.dev/schemas/v1/profile.schema.json",
  "name": "architecture-review",
  "version": "1.3.0",
  "language": "en",
  "weights": {
    "sentence_load": 25,
    "morphology": 20,
    "agency": 20,
    "lexical_clarity": 15,
    "structure": 10,
    "redundancy": 10
  },
  "bands": [
    {
      "name": "revision_required",
      "minimum": 0,
      "maximum": 69.99
    },
    {
      "name": "usable_but_improvable",
      "minimum": 70,
      "maximum": 84.99
    },
    {
      "name": "clear",
      "minimum": 85,
      "maximum": 100
    }
  ],
  "thresholds": {
    "max_sentence_words": 25,
    "max_actions_per_sentence": 3,
    "max_clauses_per_sentence": 3,
    "max_nominalizations_per_sentence": 2,
    "noun_stack_words": 3,
    "max_paragraph_words": 90,
    "max_repeated_content_word": 2,
    "max_punctuation_depth": 4,
    "max_undefined_acronyms_per_sentence": 2,
    "max_undefined_acronyms_per_paragraph": 4,
    "max_inline_list_items": 4,
    "max_sentence_purposes": 2,
    "max_qualifiers_per_sentence": 2,
    "max_compound_parts": 3
  },
